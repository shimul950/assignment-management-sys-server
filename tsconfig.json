{
  "compilerOptions": {
    "module": "ESNext",                                
    "rootDir": "./",
    "outDir": "./dist",  
    "moduleResolution": "bundler", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2023",
  },
  "include": ["src","prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}